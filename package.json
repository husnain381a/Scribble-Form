{
  "name": "scribble-forms",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Forms with a little personality. A free, open-source form builder.",
  "repository": {
    "type": "git",
    "url": "https://github.com/husnain381a/Scribble-Forms.git"
  },
  "homepage": "https://github.com/husnain381a/Scribble-Forms#readme",
  "bugs": {
    "url": "https://github.com/husnain381a/Scribble-Forms/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "prebuild": "node scripts/build-source.mjs",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src scripts tests docs .github README.md NOTICE.md CONTRIBUTING.md SECURITY.md CODE_OF_CONDUCT.md next.config.ts tsconfig.json package.json .prettierrc.json",
    "format:check": "prettier --check src scripts tests docs .github README.md NOTICE.md CONTRIBUTING.md SECURITY.md CODE_OF_CONDUCT.md next.config.ts tsconfig.json package.json .prettierrc.json",
    "check:repo": "node scripts/check-repository.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:cloud": "tsx --env-file=.env.local scripts/verify-cloud.ts",
    "test:cloud:managed": "tsx --env-file=.env.local scripts/verify-cloud-managed.ts",
    "test:security": "node --env-file=.env.local scripts/verify-security.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/shantell-sans": "^5.2.8",
    "@fontsource/caveat": "^5.2.8",
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "fflate": "^0.8.3",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
